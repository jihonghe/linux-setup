# Ghostty 配置片段 — managed by linux-setup
#
# 注意：这里**不用** global: 前缀。Linux 下全局快捷键依赖
# xdg-desktop-portal 的 GlobalShortcuts 接口，很多桌面环境没有实现。
# 非 global 的绑定在 Ghostty 窗口聚焦时生效。
#
# 如果 Omarchy 已经自带 ~/.config/ghostty/config，apply.sh 会把下面这段
# 追加进去，而不是覆盖官方配置。

# Ctrl + ` 呼出下拉终端
keybind = ctrl+backquote=toggle_quick_terminal

# 下拉终端：顶部、40% 高、跟随鼠标所在屏幕、点外部自动隐藏
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# 重启保留窗口布局
window-save-state = always
