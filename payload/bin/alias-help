#!/usr/bin/env bash
# alias-help —— 命令速查表
#
# 从 ~/.alias.sh 里的 @cmd / @usage / @example 注释实时生成，不保存副本。
# 因此修改命令后，速查表会自动同步，不存在“忘记更新”的问题。
#
# 用法:
#   alias-help              列出全部命令（含用法）
#   alias-help -v           同时显示示例
#   alias-help <关键词>      按命令名 / 说明 / 用法过滤
#   alias-help -v dl        查看单个命令的完整说明
#
# 注意: 别名请在 ~/.alias.sh 里配置（alias ah='alias-help'），本脚本不处理。
set -uo pipefail

SRC="${ALIAS_FILE:-$HOME/.alias.sh}"
VERBOSE=0
FILTER=""

for arg in "$@"; do
  case "$arg" in
    -v|--verbose) VERBOSE=1 ;;
    -h|--help)    sed -n '2,13p' "$0"; exit 0 ;;
    -*)           echo "未知参数: $arg" >&2; exit 1 ;;
    *)            FILTER="$arg" ;;
  esac
done

if [ ! -f "$SRC" ]; then
  echo "找不到命令定义文件: $SRC" >&2
  exit 1
fi

awk -v verbose="$VERBOSE" -v filter="$FILTER" '
function add(name) {
  if (name ~ /^_/) { desc = ""; use = ""; ex = ""; return }
  nitems++
  SEC[nitems] = sec
  NM[nitems]  = name
  DS[nitems]  = (desc == "" ? "(无说明，请补 @cmd)" : desc)
  US[nitems]  = use
  EX[nitems]  = ex
  desc = ""; use = ""; ex = ""
}

BEGIN { sec = "其它"; nitems = 0; desc = ""; use = ""; ex = "" }

/^# ==== .* ====$/ {
  s = $0
  sub(/^# ==== /, "", s)
  sub(/ ====$/, "", s)
  sec = s
  next
}

/^# @cmd: /     { desc = substr($0, 9);  next }
/^# @usage: /   { use  = substr($0, 11); next }
/^# @example: / { e = substr($0, 13); ex = (ex == "" ? e : ex "%%%" e); next }

/^alias +[A-Za-z0-9_-]+=/ {
  n = $0
  sub(/^alias +/, "", n)
  sub(/=.*/, "", n)
  add(n)
  next
}

/^[A-Za-z_][A-Za-z0-9_-]*\(\)/ {
  n = $0
  sub(/\(\).*/, "", n)
  add(n)
  next
}

END {
  last = ""
  found = 0
  for (i = 1; i <= nitems; i++) {
    hay = NM[i] " " DS[i] " " US[i]
    if (filter != "" && index(tolower(hay), tolower(filter)) == 0) continue
    if (SEC[i] != last) {
      print ""
      print "== " SEC[i] " =="
      last = SEC[i]
    }
    printf "  %s — %s\n", NM[i], DS[i]
    if (US[i] != "") printf "          用法: %s\n", US[i]
    if (verbose && EX[i] != "") {
      k = split(EX[i], arr, "%%%")
      for (j = 1; j <= k; j++) printf "          示例: %s\n", arr[j]
    }
    found = 1
  }
  if (!found) {
    printf "\n没有匹配 “%s” 的命令。\n", filter > "/dev/stderr"
    exit 2
  }
}
' "$SRC"

rc=$?
[ "$rc" -ne 0 ] && exit "$rc"

# ---- 工具自身（这两个是独立脚本，不在 ~/.alias.sh 里） ----
show_tools=0
if [ -z "$FILTER" ]; then
  show_tools=1
else
  for kw in alias-help alias-lint 工具 tool; do
    case "$kw" in *"$FILTER"*) show_tools=1; break ;; esac
  done
fi

if [ "$show_tools" = 1 ]; then
  echo
  echo "== 工具 =="
  echo "  alias-help — 显示这份速查表（从 ~/.alias.sh 实时生成）"
  echo "          用法: alias-help [-v] [关键词]"
  echo "          -v 显示示例；带关键词则过滤"
  echo "  alias-lint — 检查 ~/.alias.sh 里命令的注释是否完整"
  echo "          用法: alias-lint [--quiet]"
fi
