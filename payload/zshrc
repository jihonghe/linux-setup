# ~/.zshrc — managed by linux-setup
# https://github.com/jihonghe/linux-setup
#
# 设计原则：所有外部工具链都做存在性判断。
# 缺什么都不会让 shell 报错，只是那部分功能不可用。

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# ---- 路径 ----
# ~/.local/bin 放最前：alias-help / Omarchy 的 agent stubs 都在这里
export PATH="$HOME/.local/bin:$PATH"

# ---- 个人命令体系 ----
[[ -f "$HOME/.alias.sh" ]] && source "$HOME/.alias.sh"
[[ -x "$HOME/.local/bin/alias-lint" ]] && "$HOME/.local/bin/alias-lint" --quiet

# ---- 版本管理（mise，Omarchy 预装）----
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# ---- Rust ----
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

# ---- Flutter / Android ----
export DEV_HOME="$HOME/dev"
export PUB_HOSTED_URL=https://pub.flutter-io.cn
export FLUTTER_STORAGE_BASE_URL=https://storage.flutter-io.cn

[[ -d "$DEV_HOME/flutter/bin" ]] && export PATH="$DEV_HOME/flutter/bin:$PATH"

export ANDROID_HOME="$DEV_HOME/android-sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
if [[ -d "$ANDROID_HOME/platform-tools" ]]; then
  export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH"
fi

# ---- Java（Arch）----
if command -v archlinux-java >/dev/null 2>&1; then
  _jdk="$(archlinux-java get 2>/dev/null || true)"
  [[ -n "$_jdk" && -d "/usr/lib/jvm/$_jdk" ]] && export JAVA_HOME="/usr/lib/jvm/$_jdk"
  unset _jdk
elif [[ -d /usr/lib/jvm/java-21-openjdk ]]; then
  export JAVA_HOME=/usr/lib/jvm/java-21-openjdk
fi

# ---- Omarchy 的 tmux 布局函数（tdl / tds / tsl）----
# 这些是 bash 函数，zsh 可直接 source
if [[ -f "${OMARCHY_PATH:-/usr/share/omarchy}/default/bash/fns/tmux" ]]; then
  source "${OMARCHY_PATH:-/usr/share/omarchy}/default/bash/fns/tmux"
fi

# ---- 默认编辑器 ----
export EDITOR="${EDITOR:-nvim}"
